COMPOSE_OS=linux

POSTGRES_IMAGE=postgres
POSTGRES_ADMIN_USER=myuser
POSTGRES_ADMIN_PASSWORD=mysecretpassword
POSTGRES_DB=mydb

TEST_DB_USER=myuser
TEST_DB_PASSWORD=mysecretpassword
DATABASE_URL_PREFIX=postgres://myuser:mysecretpassword@postgres:5432/
DATABASE_URL_SUFFIX=?sslmode=disable

CORE_IMAGE=firewall-tester-action-core
CORE_DOCKERFILE=src/coremock/Dockerfile.linux
TEST_RUNNER_IMAGE=firewall-tester-action-test-runner
PYTHON_MOCK_IMAGE=python:3.13-alpine
PYTHON_SIDECAR_DIR=/server_tests
PYTHON_MOCK_HTTP_SERVER_PATH=/server_tests/mock_http_server.py
PYTHON_DNS_MOCK_PATH=/server_tests/dns_mock.py
PYTHON_SYSLOG_COLLECTOR_PATH=/server_tests/syslog_collector.py
TEST_LOG_DIR=/logs

IMDS_AWS_IPV6_ENABLE=true
IMDS_AWS_IPV6_SUBNET=fd00:ec2::/112
IMDS_AWS_IPV6_ADDRESS=fd00:ec2::254
SKIP_IPV6_SSRF=0
