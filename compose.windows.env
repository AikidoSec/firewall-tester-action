COMPOSE_OS=windows

DEFAULT_NETWORK_SUBNET=172.28.0.0/16
CORE_HOST_IPV4=172.28.0.10
POSTGRES_HOST_IPV4=172.28.0.11
CORE_URL=http://${CORE_HOST_IPV4}:3000

POSTGRES_IMAGE=sokigo/postgresql-windows:15.15-2022
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres
POSTGRES_DB=mydb

TEST_DB_USER=myuser
TEST_DB_PASSWORD=mysecretpassword
DATABASE_URL_PREFIX=postgres://${TEST_DB_USER}:${TEST_DB_PASSWORD}@${POSTGRES_HOST_IPV4}:5432/
DATABASE_URL_SUFFIX=?sslmode=disable

CORE_IMAGE=firewall-tester-action-core-windows
CORE_DOCKERFILE=src/coremock/Dockerfile.windows
TEST_RUNNER_IMAGE=firewall-tester-action-test-runner-windows
PYTHON_MOCK_IMAGE=python:3.13-windowsservercore-ltsc2022
PYTHON_SIDECAR_DIR=C:/server_tests
PYTHON_MOCK_HTTP_SERVER_PATH=C:/server_tests/mock_http_server.py
PYTHON_DNS_MOCK_PATH=C:/server_tests/dns_mock.py
PYTHON_SYSLOG_COLLECTOR_PATH=C:/server_tests/syslog_collector.py
TEST_LOG_DIR=C:/logs

IMDS_AWS_IPV6_ENABLE=false
IMDS_AWS_IPV6_SUBNET=172.29.254.0/24
SKIP_IPV6_SSRF=1
