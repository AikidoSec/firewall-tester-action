COMPOSE_OS=windows

POSTGRES_IMAGE=sokigo/postgresql-windows:15.15-2022
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres
POSTGRES_DB=mydb

TEST_DB_USER=myuser
TEST_DB_PASSWORD=mysecretpassword
DATABASE_URL_PREFIX=postgres://myuser:mysecretpassword@postgres:5432/
DATABASE_URL_SUFFIX=?sslmode=disable

CORE_IMAGE=firewall-tester-action-core-windows
CORE_DOCKERFILE=src/coremock/Dockerfile.windows
TEST_RUNNER_IMAGE=firewall-tester-action-test-runner-windows
PYTHON_MOCK_IMAGE=python:3.13-windowsservercore-ltsc2022
